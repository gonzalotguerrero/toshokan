<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.gonzalotguerrero</groupId>
    <artifactId>toshokan</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>toshokan</name>
    <description>A web API aimed at providing inventory management services for libraries</description>
    <url>https://github.com/gonzalotguerrero/toshokan</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>gonzalotguerrero</id>
            <name>Gonzalo Tomas Guerrero</name>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/gonzalotguerrero/toshokan</url>
        <connection>scm:git:https://github.com/gonzalotguerrero/toshokan.git</connection>
        <developerConnection>scm:git:git@github.com:gonzalotguerrero/toshokan.git</developerConnection>
    </scm>

    <modules>
        <module>toshokan-shared</module>
        <module>toshokan-catalog</module>
        <module>toshokan-inventory</module>
        <module>toshokan-members</module>
        <module>toshokan-circulation</module>
        <module>toshokan-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Only toshokan-app can be run, so it sets this back to false -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
        <!-- The 3.x line is the one for Spring Boot 4; 3.2.0 is built against Boot 4.1.2 -->
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gonzalotguerrero</groupId>
                <artifactId>toshokan-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gonzalotguerrero</groupId>
                <artifactId>toshokan-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gonzalotguerrero</groupId>
                <artifactId>toshokan-inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gonzalotguerrero</groupId>
                <artifactId>toshokan-members</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.gonzalotguerrero</groupId>
                <artifactId>toshokan-circulation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets JUnit, AssertJ, Mockito and Spring Test for its tests -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
